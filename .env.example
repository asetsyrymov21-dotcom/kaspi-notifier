# PostgreSQL connection — shared by all tenants
DATABASE_URL=postgresql://kaspi:kaspi@postgres:5432/kaspi

# Single-tenant mode — fill these and run without tenants.json
KASPI_BASE_URL=https://kaspi.kz/shop/api
KASPI_ORDERS_PATH=orders
# Alternative: KASPI_ORDERS_URL=https://kaspi.kz/shop/api/orders
KASPI_API_KEY=your_api_key_here
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=123456789
HTTP_TIMEOUT=10
DRY_RUN=0
KASPI_ORDER_STATE=
KASPI_ORDER_STATUS=
KASPI_PAGE_SIZE=
INITIAL_SYNC_MODE=mark_only
LOG_LEVEL=INFO
LOCK_FILE_PATH=/tmp/kaspi-notifier.lock
PROCESSED_RETENTION_DAYS=180

# Multi-tenant mode — point to a tenants.json file (see tenants.json.example)
# When set (or when tenants.json exists in the working directory), per-tenant
# credentials in the JSON override the per-shop fields above.
# DATABASE_URL above is shared across all tenants.
TENANTS_FILE=tenants.json
