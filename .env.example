KASPI_BASE_URL=https://kaspi.kz/shop/api
KASPI_ORDERS_PATH=orders
# или используйте KASPI_ORDERS_URL=https://kaspi.kz/shop/api/orders
KASPI_API_KEY=your_api_key_here
TELEGRAM_BOT_TOKEN=your_bot_token_here
